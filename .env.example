DB_PASSWORD=
DB_NAME=
DB_SYNCHRONIZE=
DB_MAX_CONNECTIONS=
DB_SSL_ENABLED=
DB_REJECT_UNAUTHORIZED=
DB_CA=
DB_KEY=
DB_CERT=
DB_URL=

# Encryption configuration
CRYPTO_SALT_ROUNDS=12

# JWT settings
