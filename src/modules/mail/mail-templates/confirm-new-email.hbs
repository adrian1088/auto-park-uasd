<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{{title}}</title>
  </head>
  <body style='font-family: Arial, sans-serif;'>
    <div
      style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px; color: #333;'
    >
      <img
        src='cid:autoparkLogo'
        alt='AutoPark UASD'
        width='140'
        style='display: block; width: 240px; height: auto; margin: 0 auto 16px;'
      />
      <div>
        <p>{{text1}}</p>
        <p>{{text2}}</p>
        <p>{{text3}}</p>
      </div>
      <div style='text-align: center; margin-top: 20px;'>
        <a
          href='{{url}}'
          style='display:inline-block;padding:20px;background:#0284c7;text-decoration:none;color:#ffffff'
        >{{actionTitle}}</a>
      </div>
      <p
        style='font-size: 12px; color: #64748b; text-align: center; margin-top: 30px;'
      >
        Este es un mensaje automático del sistema AutoPark UASD. No respondas a
        este correo.
      </p>
    </div>
  </body>
</html>